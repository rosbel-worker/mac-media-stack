# =============================================================
# Media Stack Configuration
# =============================================================
# Copy this file to .env and fill in the values below.
# Lines starting with # are comments (ignored).
# =============================================================

# --- PATHS ---
# Where your media content lives (movies, TV shows, downloads, logs).
# Default: ~/Media (a folder in your home directory)
# Change this if your media is on an external or network drive.
MEDIA_DIR=/Users/YOURUSERNAME/Media
# Optional SMB URL used by auto-heal to re-mount MEDIA_DIR after login/reboot.
# Example: smb://YOURUSERNAME@nas.local/media
# Store the password in macOS Keychain; do not put credentials in this file.
MEDIA_SHARE_URL=
# Where app configs/databases live (Radarr/Sonarr/qBittorrent/Seerr/etc).
# Keep this on local disk for SQLite reliability (do not put this on SMB/NFS).
# Default: ~/home-media-stack/config
CONFIG_DIR=/Users/YOURUSERNAME/home-media-stack/config

# --- USER IDS ---
# These tell Docker to run as YOUR Mac user (so files aren't owned by root).
# To find yours, open Terminal and run: id -u
# Default 501 is correct for most Macs (first user account).
PUID=501
PGID=20

# --- TIMEZONE ---
# Your timezone. Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# --- WEB ACCESS ---
# Bind service web UIs to 127.0.0.1 for local-only access, or 0.0.0.0 to expose on LAN/Tailnet.
# These defaults stay local-only; change selected services to 0.0.0.0 if you want Tailnet/LAN access.
SEERR_BIND_IP=127.0.0.1
QBITTORRENT_BIND_IP=127.0.0.1
PROWLARR_BIND_IP=127.0.0.1
SONARR_BIND_IP=127.0.0.1
RADARR_BIND_IP=127.0.0.1
BAZARR_BIND_IP=127.0.0.1
FLARESOLVERR_BIND_IP=127.0.0.1

# --- VPN ---
# Choose your VPN provider: protonvpn (default) or pia
# Use --pia with bootstrap or scripts/setup.sh to auto-configure PIA.
VPN_PROVIDER=protonvpn

# --- VPN connection (auto-set by bootstrap/setup based on VPN_PROVIDER) ---
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
SERVER_COUNTRIES=United States
SERVER_REGIONS=
# VPN_PORT_FORWARDING_PROVIDER controls which provider-specific forwarding code is used.
# Leave it empty to use the current VPN provider automatically.
# If you set it explicitly for PIA, use exactly: private internet access
# Do not use pia for this field.
VPN_PORT_FORWARDING_PROVIDER=protonvpn

# --- ProtonVPN credentials (when VPN_PROVIDER=protonvpn) ---
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_ADDRESSES=your_wireguard_address_here

# --- PIA credentials (when VPN_PROVIDER=pia) ---
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- MEDIA SERVER ---
# plex (default, runs natively on macOS) or jellyfin (runs in Docker)
MEDIA_SERVER=plex
